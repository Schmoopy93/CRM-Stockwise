rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function shopPath(shopId) {
      return /databases/$(database)/documents/shops/$(shopId);
    }

    function productPath(shopId, productId) {
      return /databases/$(database)/documents/shops/$(shopId)/products/$(productId);
    }

    function variantPath(shopId, productId, variantId) {
      return /databases/$(database)/documents/shops/$(shopId)/products/$(productId)/variants/$(variantId);
    }

    function stockEventPath(shopId, eventId) {
      return /databases/$(database)/documents/shops/$(shopId)/stockEvents/$(eventId);
    }

    function salePath(shopId, saleId) {
      return /databases/$(database)/documents/shops/$(shopId)/sales/$(saleId);
    }

    function isMember(shopId) {
      return signedIn()
        && exists(userPath(request.auth.uid))
        && get(userPath(request.auth.uid)).data.shopId == shopId;
    }

    function isShopOwner(shopId) {
      return isMember(shopId)
        && get(userPath(request.auth.uid)).data.role == 'owner';
    }

    function validProductImages(data) {
      return !('images' in data)
        || (data.images is list && data.images.size() == 0)
        || (data.images is list && data.images.size() <= 6 && data.images[0] is string);
    }

    function validProductPricing(data) {
      return (!('costPrice' in data) || (data.costPrice is number && data.costPrice >= 0))
        && (!('salePrice' in data) || (data.salePrice is number && data.salePrice >= 0))
        && (!('compareAtPrice' in data) || (data.compareAtPrice is number && data.compareAtPrice >= 0))
        && (!('supplier' in data)
          || (data.supplier is map
            && data.supplier.keys().hasOnly(['name', 'contact', 'notes'])
            && data.supplier.name is string
            && (!('contact' in data.supplier) || data.supplier.contact is string)
            && (!('notes' in data.supplier) || data.supplier.notes is string)));
    }

    /** A customer record: who the shop sells to. Staff-written, so the shape is
     * pinned here and the caps match `lib/customers.ts`. Tags are a filter
     * list — capped, and every entry has to be a string, so they stay usable as
     * an exact-match index rather than free text. */
    function validCustomerProfile(data) {
      return data.name is string
        && data.name.size() > 0
        && data.name.size() <= 100
        && data.contact is string
        && data.contact.size() <= 100
        && data.email is string
        && data.email.size() <= 254
        && data.note is string
        && data.note.size() <= 2000
        && data.tags is list
        && data.tags.size() <= 20
        && (data.tags.size() == 0 || (data.tags[0] is string && data.tags[0].size() <= 30));
    }

    /** A link from a sale or an order to a customer record. Optional everywhere
     * it appears, because an anonymous catalog order has no customer and an old
     * sale predates the CRM — absence is valid, presence is not. */
    function validCustomerRef(data) {
      return !('customerId' in data)
        || (data.customerId is string
          && data.customerId.size() > 0
          && data.customerId.size() <= 100);
    }

    function validStatStep(after, before, key) {
      return after.get(key, 0) == before.get(key, 0)
        || after.get(key, 0) == before.get(key, 0) + 1;
    }

    function validStatWrite(after, before) {
      return after.keys().hasOnly(['views', 'whatsapp', 'telegram', 'instagram', 'share', 'orders'])
        && after.diff(before).affectedKeys().size() == 1
        && validStatStep(after, before, 'views')
        && validStatStep(after, before, 'whatsapp')
        && validStatStep(after, before, 'telegram')
        && validStatStep(after, before, 'instagram')
        && validStatStep(after, before, 'share')
        && validStatStep(after, before, 'orders');
    }

    /** Shared AI rate-limit buckets. Callers are anonymous (public chat) or a
     * verified user, so writes are open but pinned to a counter that may only
     * move by one, and a window start that may only move forward. The window
     * start is bounded near server time so a caller cannot hold its bucket open
     * by claiming a far-future window; the tolerance absorbs clock skew between
     * the calling function and Firestore. Starting a new window is allowed but
     * resets the count to one, so it buys at most one extra call per minute. */
    function validRateLimitWrite(after, before) {
      let first = before.keys().hasOnly([]);
      return after.keys().hasOnly(['count', 'windowStart'])
        && after.count is int
        && after.count >= 0
        && after.windowStart is timestamp
        && after.windowStart <= request.time + duration.value(60, 's')
        && (first
          ? after.count == 1
          : ((after.windowStart == before.windowStart
              && after.count == before.count + 1)
            || (after.windowStart > before.windowStart
              && after.count == 1)));
    }

    function validStockEventLink(shopId, productId, variantId, eventId, delta) {
      let event = getAfter(stockEventPath(shopId, eventId)).data;
      let oldVariant = get(variantPath(shopId, productId, variantId)).data;
      let newVariant = getAfter(variantPath(shopId, productId, variantId)).data;
      let oldProduct = get(productPath(shopId, productId)).data;
      let newProduct = getAfter(productPath(shopId, productId)).data;
      return isMember(shopId)
        && event.productId == productId
        && event.variantId == variantId
        && event.actorUid == request.auth.uid
        && event.delta == delta
        && event.createdAt == request.time
        && newVariant.quantity == oldVariant.quantity + delta
        && newVariant.lastStockEventId == eventId
        && newProduct.totalQuantity == oldProduct.totalQuantity + delta
        && newProduct.lastStockEventId == eventId;
    }

    function validOrderFulfillmentStep(shopId) {
      let index = request.resource.data.lastFulfilledLineIndex;
      let line = request.resource.data.lines[index];
      let before = resource.data.get('fulfilledLineIndices', []);
      let after = request.resource.data.fulfilledLineIndices;
      let event = getAfter(stockEventPath(shopId, request.resource.data.lastFulfillmentEventId)).data;
      return index is int
        && index >= 0
        && index < request.resource.data.lines.size()
        && request.resource.data.lastFulfillmentEventId is string
        && after is list
        && after.size() == before.size() + 1
        && after.hasAll(before)
        && after.hasAny([index])
        && !before.hasAny([index])
        && event.productId == line.productId
        && event.delta == -line.quantity
        && event.reason == 'sale'
        && event.actorUid == request.auth.uid
        && (('variantId' in line && event.variantId == line.variantId)
          || (!('variantId' in line) && event.variantLabel == line.variantLabel));
    }

    match /users/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if false;

      // A user may only create their own profile. New-shop creation is atomic:
      // the paired shop document must be created in the same batch.
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['shopId', 'displayName', 'role'])
        && request.resource.data.shopId is string
        && request.resource.data.displayName is string
        && request.resource.data.role in ['owner', 'staff']
        && ((request.resource.data.role == 'owner'
            && getAfter(shopPath(request.resource.data.shopId)).data.createdBy == uid)
          || (request.resource.data.role == 'staff'
            && exists(shopPath(request.resource.data.shopId))));

      // Shop membership and role changes must go through a trusted admin flow.
      allow update, delete: if false;
    }

    match /shops/{shopId} {
      // Authenticated users can read a known shop ID to join it. When the
      // public catalog is enabled, the shop name/contact are world-readable
      // so the catalog page can render.
      allow get: if signedIn() || resource.data.catalogEnabled == true;
      allow list: if isMember(shopId);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'createdBy'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.createdBy == request.auth.uid
        && getAfter(userPath(request.auth.uid)).data.shopId == shopId
        && getAfter(userPath(request.auth.uid)).data.role == 'owner';
      allow update, delete: if isShopOwner(shopId);

      match /products/{productId} {
        allow read: if isMember(shopId);
        allow create: if isMember(shopId)
          && request.resource.data.keys().hasOnly([
            'name', 'sku', 'category', 'minStock', 'imageUrl', 'images', 'totalQuantity',
            'customFieldDefinitions', 'customFieldValues', 'updatedAt',
            'costPrice', 'salePrice', 'compareAtPrice', 'supplier', 'catalogHidden', 'createdAt'
          ])
          && (!('createdAt' in request.resource.data) || request.resource.data.createdAt == request.time)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.sku is string
          && request.resource.data.category is string
          && request.resource.data.minStock is int
          && request.resource.data.minStock >= 0
          && request.resource.data.totalQuantity is int
          && request.resource.data.totalQuantity >= 0
          && request.resource.data.imageUrl is string
          && validProductImages(request.resource.data)
          && validProductPricing(request.resource.data);
        allow delete: if isMember(shopId)
          && resource.data.totalQuantity == 0;
        allow update: if isMember(shopId)
          && (request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['name', 'sku', 'category', 'minStock', 'imageUrl', 'images', 'customFieldDefinitions', 'customFieldValues', 'updatedAt', 'costPrice', 'salePrice', 'compareAtPrice', 'supplier', 'catalogHidden'])
                && request.resource.data.minStock is int
                && request.resource.data.minStock >= 0
                && validProductImages(request.resource.data)
                && validProductPricing(request.resource.data)
              || (request.resource.data.diff(resource.data).affectedKeys()
                    .hasOnly(['totalQuantity', 'updatedAt', 'lastStockEventId'])
                  && request.resource.data.lastStockEventId is string
                  && validStockEventLink(
                    shopId,
                    productId,
                    getAfter(stockEventPath(shopId, request.resource.data.lastStockEventId)).data.variantId,
                    request.resource.data.lastStockEventId,
                    getAfter(stockEventPath(shopId, request.resource.data.lastStockEventId)).data.delta
                  )));

        match /variants/{variantId} {
          allow read: if isMember(shopId);
          allow create: if isMember(shopId)
            && request.resource.data.keys().hasOnly(['label', 'sku', 'quantity'])
            && request.resource.data.label is string
            && request.resource.data.sku is string
            && request.resource.data.quantity is int
            && request.resource.data.quantity >= 0
            && (!exists(productPath(shopId, productId)) || request.resource.data.quantity == 0);
          allow delete: if isMember(shopId) && resource.data.quantity == 0;
          allow update: if isMember(shopId)
            && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['label', 'sku'])
                && request.resource.data.label is string
                && request.resource.data.sku is string
                || (request.resource.data.diff(resource.data).affectedKeys()
                      .hasOnly(['quantity', 'lastStockEventId'])
                    && request.resource.data.quantity is int
                    && request.resource.data.quantity >= 0
                    && request.resource.data.lastStockEventId is string
                    && validStockEventLink(
                      shopId,
                      productId,
                      variantId,
                      request.resource.data.lastStockEventId,
                      request.resource.data.quantity - resource.data.quantity
                    )));
        }
      }

      match /customers/{customerId} {
        // Customer records are private to the shop: a contact and a purchase
        // history are not catalog material and never become world-readable.
        allow read: if isMember(shopId);
        allow create: if isMember(shopId)
          && request.resource.data.keys().hasOnly([
            'name', 'contact', 'email', 'note', 'tags', 'createdAt', 'updatedAt'
          ])
          && validCustomerProfile(request.resource.data)
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        // `createdAt` is absent from the allowed diff, so a record can be edited
        // forever but never backdated into the shop's history.
        allow update: if isMember(shopId)
          && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['name', 'contact', 'email', 'note', 'tags', 'updatedAt'])
          && validCustomerProfile(request.resource.data);
        // Deleting a record leaves sales and orders pointing at a missing
        // document. They keep the name and contact written on them, so the
        // history still reads; only the CRM entry is gone.
        allow delete: if isMember(shopId);
      }

      match /catalog/{catalogId} {
        // World-readable: documents contain only customer-safe fields.
        allow read: if true;
        allow create, update: if isMember(shopId)
          && request.resource.data.keys().hasOnly([
            'name', 'category', 'imageUrl', 'images', 'salePrice', 'compareAtPrice', 'variants', 'variantIds', 'stockQuantity', 'variantStock', 'fields', 'hidden', 'createdAt', 'updatedAt'
          ])
          && (!('stockQuantity' in request.resource.data)
            || (request.resource.data.stockQuantity is int && request.resource.data.stockQuantity >= 0))
          && (!('variantStock' in request.resource.data)
            || (request.resource.data.variantStock is map && request.resource.data.variantStock.size() <= 200))
          && (!('compareAtPrice' in request.resource.data)
            || (request.resource.data.compareAtPrice is number && request.resource.data.compareAtPrice >= 0))
          && (!('createdAt' in request.resource.data) || request.resource.data.createdAt is timestamp)
          && request.resource.data.name is string
          && request.resource.data.category is string
          && request.resource.data.imageUrl is string
          && (!('images' in request.resource.data)
            || (request.resource.data.images is list && request.resource.data.images.size() <= 6))
          && (!('salePrice' in request.resource.data)
            || (request.resource.data.salePrice is number && request.resource.data.salePrice >= 0))
          && request.resource.data.variants is list
          && (!('variantIds' in request.resource.data)
            || (request.resource.data.variantIds is list
              && request.resource.data.variantIds.size() == request.resource.data.variants.size()
              && request.resource.data.variantIds.size() <= 200))
          && request.resource.data.fields is list
          && request.resource.data.hidden is bool
          && request.resource.data.updatedAt == request.time;
        allow delete: if isMember(shopId);
      }

      match /catalogStats/{day} {
        // Anonymous visitors may only bump a single counter by one per write.
        allow read: if isMember(shopId);
        allow create, update: if day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && get(shopPath(shopId)).data.catalogEnabled == true
          && validStatWrite(request.resource.data, resource == null ? {} : resource.data);
        allow delete: if false;
      }

      match /orders/{orderId} {
        // Customers are anonymous here, so creates are pinned to a fixed shape
        // and only while the public catalog is actually on. Only member-driven
        // fulfillment moves stock through the ledger.
        allow read: if isMember(shopId);
        allow create: if get(shopPath(shopId)).data.catalogEnabled == true
          && request.resource.data.keys().hasOnly([
            'code', 'lines', 'total', 'currency', 'customerName', 'customerContact', 'customerEmail', 'customerAddress', 'customerCity', 'note', 'channel', 'status', 'createdAt'
          ])
          && request.resource.data.code is string
          && request.resource.data.code.matches('^[A-Z0-9]{4,12}$')
          && request.resource.data.lines is list
          && request.resource.data.lines.size() > 0
          && request.resource.data.lines.size() <= 50
          && request.resource.data.lines[0].keys().hasOnly([
            'productId', 'variantId', 'productName', 'variantLabel', 'quantity', 'unitPrice', 'baseUnitPrice'
          ])
          && request.resource.data.lines[0].productId is string
          && (!('variantId' in request.resource.data.lines[0])
            || request.resource.data.lines[0].variantId is string)
          && request.resource.data.lines[0].productName is string
          && request.resource.data.lines[0].productName.size() <= 100
          && request.resource.data.lines[0].variantLabel is string
          && request.resource.data.lines[0].variantLabel.size() <= 100
          && request.resource.data.lines[0].quantity is int
          && request.resource.data.lines[0].quantity > 0
          && request.resource.data.lines[0].quantity <= 999
          && request.resource.data.lines[0].unitPrice is number
          && request.resource.data.lines[0].unitPrice >= 0
          && (!('baseUnitPrice' in request.resource.data.lines[0])
            || (request.resource.data.lines[0].baseUnitPrice is number
              && request.resource.data.lines[0].baseUnitPrice >= 0))
          && request.resource.data.total is number
          && request.resource.data.total >= 0
          && request.resource.data.total <= 100000000
          && request.resource.data.currency is string
          && request.resource.data.currency.matches('^[A-Z]{3}$')
          && request.resource.data.customerName is string
          && request.resource.data.customerName.size() > 0
          && request.resource.data.customerName.size() <= 100
          && request.resource.data.customerContact is string
          && request.resource.data.customerContact.size() > 0
          && request.resource.data.customerContact.size() <= 100
          && request.resource.data.customerEmail is string
          && request.resource.data.customerEmail.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
          && request.resource.data.customerEmail.size() <= 254
          && request.resource.data.customerAddress is string
          && request.resource.data.customerAddress.size() > 0
          && request.resource.data.customerAddress.size() <= 200
          && request.resource.data.customerCity is string
          && request.resource.data.customerCity.size() > 0
          && request.resource.data.customerCity.size() <= 100
          && request.resource.data.note is string
          && request.resource.data.note.size() <= 500
          && request.resource.data.channel in ['catalog', 'whatsapp', 'telegram', 'instagram', 'other']
          && request.resource.data.status == 'new'
          && request.resource.data.createdAt == request.time;
        // Members move an order through its lifecycle, attach the customer
        // contact, and claim the order for a customer record, but they may not
        // rewrite what was ordered, in what currency, or when. `total` and
        // `currency` stay fixed from the moment the customer placed it, so the
        // quote the shop approved is still the quote on file.
        allow update: if isMember(shopId)
          && request.resource.data.keys().hasOnly([
            'code', 'lines', 'total', 'currency', 'customerName', 'customerContact', 'customerEmail', 'customerAddress', 'customerCity', 'customerId', 'note', 'channel', 'status', 'fulfilledLineIndices', 'lastFulfilledLineIndex', 'lastFulfillmentEventId', 'saleId', 'createdAt'
          ])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'customerName', 'customerContact', 'customerId', 'fulfilledLineIndices', 'lastFulfilledLineIndex', 'lastFulfillmentEventId', 'saleId'])
          && request.resource.data.status in ['new', 'confirmed', 'fulfilling', 'fulfilled', 'cancelled']
          && (request.resource.data.status == resource.data.status
            || (resource.data.status == 'new' && request.resource.data.status in ['confirmed', 'cancelled'])
            || (resource.data.status == 'confirmed' && request.resource.data.status in ['fulfilling', 'cancelled'])
            || (resource.data.status == 'fulfilling' && request.resource.data.status in ['fulfilling', 'fulfilled']))
          && request.resource.data.customerName is string
          && request.resource.data.customerName.size() <= 100
          && request.resource.data.customerContact is string
          && request.resource.data.customerContact.size() <= 100
          && (request.resource.data.status != 'fulfilling'
            || (resource.data.status == 'fulfilling'
              && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                'fulfilledLineIndices', 'lastFulfilledLineIndex', 'lastFulfillmentEventId'
              ]))
            || ('fulfilledLineIndices' in request.resource.data
              && request.resource.data.fulfilledLineIndices.size() <= request.resource.data.lines.size()
              && validOrderFulfillmentStep(shopId)))
          && (request.resource.data.status != 'fulfilled'
            || ('saleId' in request.resource.data
              && request.resource.data.saleId is string
              && request.resource.data.saleId.size() > 0
              && 'fulfilledLineIndices' in request.resource.data
              && request.resource.data.fulfilledLineIndices.size() == request.resource.data.lines.size()
              && existsAfter(salePath(shopId, request.resource.data.saleId))
              && getAfter(salePath(shopId, request.resource.data.saleId)).data.sourceOrderId == orderId))
          && validCustomerRef(request.resource.data);
        allow delete: if false;
      }

      match /sales/{saleId} {
        allow read: if isMember(shopId);
        allow create: if isMember(shopId)
          && request.resource.data.keys().hasOnly([
            'lines', 'total', 'channel', 'buyerName', 'buyerContact', 'buyerInstagram', 'customerId', 'sourceOrderId', 'sourceOrderCode', 'note', 'actorUid', 'actorName', 'createdAt'
          ])
          && request.resource.data.keys().hasAny(['buyerContact', 'buyerInstagram'])
          && !request.resource.data.keys().hasAll(['buyerContact', 'buyerInstagram'])
          && request.resource.data.lines is list
          && request.resource.data.lines.size() > 0
          && request.resource.data.lines.size() <= 100
          && request.resource.data.total is number
          && request.resource.data.total >= 0
          && request.resource.data.total <= 100000000
          && request.resource.data.channel in ['instagram', 'facebook', 'store', 'phone', 'catalog', 'other']
          && request.resource.data.buyerName is string
          && request.resource.data.buyerName.size() <= 100
          && (
            ('buyerContact' in request.resource.data
              && request.resource.data.buyerContact is string
              && request.resource.data.buyerContact.size() <= 100)
            || ('buyerInstagram' in request.resource.data
              && request.resource.data.buyerInstagram is string
              && request.resource.data.buyerInstagram.size() <= 100)
          )
          && request.resource.data.note is string
          && request.resource.data.note.size() <= 500
          && (!('sourceOrderId' in request.resource.data)
            || (request.resource.data.sourceOrderId is string
              && request.resource.data.sourceOrderId.size() > 0
              && request.resource.data.sourceOrderCode is string
              && request.resource.data.sourceOrderCode.size() > 0))
          && validCustomerRef(request.resource.data)
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.actorName is string
          && request.resource.data.actorName.size() <= 100
          && request.resource.data.createdAt == request.time;
        // A sale is otherwise immutable — its lines are already reflected in the
        // stock ledger, so nothing here may be rewritten. Attributing it to a
        // customer is the single exception: it records who it was to, and the
        // buyer name and total on file stay exactly what the till produced.
        allow update: if isMember(shopId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['customerId'])
          && validCustomerRef(request.resource.data);
        allow delete: if false;
      }

      match /stockEvents/{eventId} {
        allow read: if isMember(shopId);
        allow create: if isMember(shopId)
          && request.resource.data.keys().hasOnly([
            'productId', 'variantId', 'variantLabel', 'delta', 'reason', 'actorUid', 'actorName', 'createdAt'
          ])
          && request.resource.data.productId is string
          && request.resource.data.variantId is string
          && request.resource.data.variantLabel is string
          && request.resource.data.delta is int
          && request.resource.data.delta != 0
          && request.resource.data.reason in ['adjustment', 'receipt', 'sale', 'return', 'correction']
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.actorName is string
          && request.resource.data.createdAt == request.time
          && validStockEventLink(
            shopId,
            request.resource.data.productId,
            request.resource.data.variantId,
            eventId,
            request.resource.data.delta
          );
        allow update, delete: if false;
      }
    }

    // AI rate-limit buckets shared by the serverless route handlers, so the
    // budget holds across every instance instead of one warm function. The
    // limiter counts a call by reading the bucket and writing it back in one
    // transaction, so reading a single bucket has to be allowed — with reads
    // denied the transaction could never start and every call fell back to a
    // per-instance counter. Bucket ids are hashes of the caller, so there is
    // nothing to list and nothing to find by guessing; listing and deleting
    // stay closed, and a write still has to move the counter by exactly one.
    match /rateLimits/{bucketId} {
      allow get: if true;
      allow list, delete: if false;
      allow create, update: if validRateLimitWrite(request.resource.data, resource == null ? {} : resource.data);
    }
  }
}
