rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isShopMember(shopId) {
      let profilePath = /databases/(default)/documents/users/$(request.auth.uid);
      return signedIn()
        && firestore.exists(profilePath)
        && firestore.get(profilePath).data.shopId == shopId;
    }

    match /shops/{shopId}/products/{fileName} {
      allow read: if isShopMember(shopId);
      allow write: if isShopMember(shopId)
        && request.resource != null
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*')
        && fileName.matches('^[A-Za-z0-9_-]+\\.jpg$');
      allow delete: if isShopMember(shopId);
    }
  }
}
